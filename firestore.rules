rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// قواعد أمان Firestore — تطبيق «درسلي»
//
// السياسة المعتمدة (A-42، 2026-10-27):
//   1. users/{uid}: قراءة/كتابة لصاحبه فقط، والدور لا يتغيّر بعد الكتابة الأولى.
//   2. teacherProfiles/{uid}: القراءة العامة للملفات المعتمدة فقط؛ صاحبه يرى
//      ملفه بكل حالاته ولا يستطيع تغيير status.
//   3. لا وصول إداري من التطبيق: الاعتماد والتمييز بأدوات إدارية خارجية
//      (Firebase Console أو سكربت بمفتاح خدمة لا يصل للتطبيق).
//   4. المجموعات (P7) وصاحبها فقط يكتب، والطلبات (P8) لكل طالب طلبه الواحد،
//      وحجز المقعد زيادة واحدة ذرّية يقبلها الخادم لا الواجهة.
//   5. الجدول والمحادثة (P9): يقرأهما صاحب المجموعة والأعضاء المقبولون فقط
//      (`exists()` على مستند العضو)، ويكتب الجدول المالك وحده، ولا رسالة
//      تُعدَّل أو تُحذف بعد إرسالها.
//   6. قائمة الانتظار (P9): للمجموعة **المكتملة** فقط، والمنتظر لا يشغل مقعدًا
//      ولا يرى الجدول/المحادثة. إزالة عضو تنقص المقعد، وقبول منتظر يزيده —
//      كلاهما بمعاملة، والقواعد تحدّ الفرق بمقعد واحد في الاتجاهين.
//   7. سعة المجموعة (P9): حدّ **صارم 40**، ولا تُقلَّب تحت المنضمين، ولا
//      تتغيّر مع seatsTaken في كتابة واحدة. والنقل بين مجموعتين يحرّك مقعدًا
//      في كل اتجاه ويُنشئ عضوية تحمل groupId مطابقًا لمسارها.
//   9. الحجوزات (P10): الطالب ينشئ، والمدرس يقبل/يرفض/يعلن التنفيذ، والطرفان
//      يلغيان ويقترحان وقتًا بديلًا — كل انتقال بقائمة حقول محددة. وتقويم يومي
//      لكل مدرس يحوّل «هل الوقت مشغول؟» إلى قراءة مستند واحد داخل المعاملة.
//  10. المحادثات المباشرة (P11): خيط واحد لكل زوج (مدرس، طالب) بمعرّف مشتق،
//      ولا خيط بلا أصل: حجز بين الطرفين، أو عضوية مجموعة عند المدرس، أو
//      استفسار يسمح به المدرس صراحةً. والقراءة والكتابة للطرفين فقط.
//  11. الإشعارات (P12): المستلم وحده يقرأ ويعلّم مقروءًا ويحذف. والإنشاء من
//      الطرف الذي نفّذ الفعل فعلًا (`actorId == uid`)، بعد التحقق من **علاقة
//      حقيقية** بينه وبين المستلم: حجز يجمعهما، أو محادثة يشاركان فيها، أو
//      مجموعة يملكها والمستلم عضو فيها. لا يوجد «أرسل إشعارًا لأي أحد».
//  12. التقييمات (P13): لا يُكتب تقييم إلا لحجز **منفّذ** لصاحبه، ومعرّف
//      التقييم هو معرّف الحجز — فلا تقييم مكرر ولا تقييم بلا حصة. ولا تعديل
//      ولا حذف بعد الكتابة. والمتوسط في `teacherRatings` لا يتحرك إلا بمقدار
//      تقييمٍ أُنشئ في **نفس الكتابة الذرّية** (getAfter)، فلا يمكن نفخه.
//  13. المفضلة (P13): مستند لكل (طالب، نوع، هدف) بمعرّف مشتق، وقراءته وحذفه
//      لصاحبه فقط، ولا تعديل أصلًا.
//   8. تنظيف صفوف النقل (P9): المالك يحذف صفوف الانضمام/الانتظار **المفتوحة**
//      فقط (pending/accepted وwaiting/promoted)؛ الصفوف المغلقة تاريخ لا يُمحى.
//      لا يُفتح الحذف على العضوية ولا على المقاعد، فلا يستطيع أحد «تحرير
//      مقعد» بالحذف.
//
// المبدأ الحاكم: **كل شيء ممنوع إلا ما نُصّ عليه**. القاعدة الأخيرة ترفض أي
// مجموعة مستندات غير مذكورة، حتى لو أضافها كود لاحقًا بالخطأ.
//
// ⚠️ هذه القواعد لم تُنشر بعد. النشر يتم من صاحب المشروع (انظر docs/P5_FIRESTORE.md).
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // حساب إداري: يُمنح فقط عبر Custom Claim يُضبط بمفتاح خدمة خارج التطبيق.
    // التطبيق لا يستطيع منح نفسه هذا الادعاء إطلاقًا.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ── 1) users/{uid} ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'role', 'createdAt', 'roleChosenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // الدور ثابت: أي محاولة لتغييره تُرفض. بقية الحقول (الاسم/البريد) يجوز
      // تحديثها، والحقول غير المعروفة مرفوضة.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'role', 'createdAt', 'roleChosenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // لا حذف من التطبيق: حذف الحساب إجراء إداري (سياسة الاحتفاظ T-10).
      allow delete: if isAdmin();
    }

    // ── 2) teacherProfiles/{uid} ─────────────────────────────────────────────
    match /teacherProfiles/{uid} {
      // القراءة: الملف المعتمد للجميع، وصاحبه يرى ملفه بأي حالة.
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || isSelf(uid);

      // الإنشاء: صاحبه فقط، وبداية دورة المراجعة إجبارية.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pendingReview'
        && request.resource.data.ownerId == uid
        && request.resource.data.keys().hasOnly(
             ['ownerId', 'displayName', 'status', 'createdAt',
              'subject', 'stage', 'area', 'bio', 'priceHint'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // التحديث: صاحبه يعدّل حقوله الوصفية فقط.
      // - status و ownerId ثابتان (يُضبطان إداريًا أو عند الإنشاء).
      // - isFeatured و rating و reviewsCount غير مذكورة في hasOnly ⇒ لا يكتبها
      //   التطبيق إطلاقًا.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly(
             ['ownerId', 'displayName', 'status', 'createdAt',
              'subject', 'stage', 'area', 'bio', 'priceHint'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
      );

      // لا حذف من التطبيق.
      allow delete: if isAdmin();
    }

    // ── 3) studyGroups/{groupId} ─────────────────────────────────────────────
    // القراءة: النشِطة للمسجّلين، وصاحبها يرى الموقوفة.
    // الكتابة: **المدرس صاحب المجموعة فقط** (P7): إنشاء/تعديل/إيقاف.
    // لا حذف من التطبيق — الإيقاف عبر isActive بدل فقدان سجل الطلاب.
    match /studyGroups/{groupId} {
      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.teacherId;
      }

      function validGroupPayload() {
        return request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 40
          && request.resource.data.stage is string
          && request.resource.data.stage.size() > 0
          && request.resource.data.stage.size() <= 40
          && request.resource.data.teacherName is string
          && request.resource.data.teacherName.size() > 0
          && request.resource.data.teacherName.size() <= 80
          && request.resource.data.meetingMode in ['online', 'home', 'center']
          && request.resource.data.isActive is bool;
      }

      // السعة: عدد صحيح بين 2 و**40 حدًّا صارمًا** (A-70)، ولا تقل عن المنضمين.
      // هذا الفحص يغطي تعديل السعة في أي وقت، ويبقى seatsTaken مشدودًا في
      // قاعدة التعديل العامة (أ): أي محاولة لتغيير الاثنين معًا تُرفض.
      function validSeats() {
        return request.resource.data.seatsTotal is int
          && request.resource.data.seatsTotal >= 2
          && request.resource.data.seatsTotal <= 40
          && request.resource.data.seatsTotal >= request.resource.data.seatsTaken;
      }

      function groupKeys() {
        return ['teacherId', 'teacherName', 'title', 'subject', 'stage',
                'seatsTotal', 'seatsTaken', 'meetingMode', 'scheduleNote',
                'isActive'];
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.isActive == true
             || request.auth.uid == resource.data.teacherId
           ));

      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(groupKeys())
        && request.resource.data.seatsTaken == 0
        && request.resource.data.isActive == true
        && validGroupPayload()
        && validSeats()
        && (
             !('scheduleNote' in request.resource.data.keys())
             || (request.resource.data.scheduleNote is string
                 && request.resource.data.scheduleNote.size() <= 120)
           );

      // (أ) تعديل البيانات العادي: المالك فقط، ولا يغيّر المالك ولا المقاعد
      // المشغولة. قبول الطلبات له قاعدة منفصلة (ب) لأن القواعد تُقيَّم كـOR.
      allow update: if isAdmin() || (
        isGroupOwner()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.seatsTaken == resource.data.seatsTaken
        && request.resource.data.keys().hasOnly(groupKeys())
        && validGroupPayload()
        && validSeats()
        && (
             !('scheduleNote' in request.resource.data.keys())
             || (request.resource.data.scheduleNote is string
                 && request.resource.data.scheduleNote.size() <= 120)
           )
      );

      // (ب) حجز مقعد عند قبول طلب انضمام (P8) أو قبول منتظر أو **نقل عضو**
      // إلى هذه المجموعة (P9):
      //   - المالك فقط، والمجموعة منشورة.
      //   - **لا يتغيّر أي حقل آخر** غير seatsTaken (diff.hasOnly).
      //   - الزيادة **واحد بالضبط** ولا تتجاوز السعة الكلية.
      // وبما أن المعاملة تُعيد قراءة المستند، فإن قبولين متزامنين على المقعد
      // الأخير لا يمرّان: الثاني يرى seatsTaken مساويًا للسعة فيُرفض.
      allow update: if isGroupOwner()
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsTaken'])
        && request.resource.data.seatsTaken == resource.data.seatsTaken + 1
        && request.resource.data.seatsTaken <= resource.data.seatsTotal;

      // (ج) تحرير مقعد عند إزالة عضو **أو نقل عضو خارج المجموعة** (P9):
      //   - المالك فقط (يعمل مع المجموعة الموقوفة أيضًا: الإدارة لا تتوقف).
      //   - **لا يتغيّر أي حقل آخر** غير seatsTaken، والنقص واحد بالضبط.
      //   - لا يصبح العدد سالبًا.
      allow update: if isGroupOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsTaken'])
        && request.resource.data.seatsTaken == resource.data.seatsTaken - 1
        && request.resource.data.seatsTaken >= 0;

      allow delete: if isAdmin();
// (نص scheduleNote الفارغ مقبول: يعني «بلا موعد محدد».)

      // أعضاء المجموعة: المدرس صاحب المجموعة والإدارة فقط.
      // الطالب لا يرى أسماء بقية الطلاب (خصوصية).
      //
      // الإنشاء مسموح للمالك فقط لأنه يحدث داخل معاملة قبول الطلب أو النقل؛
      // ومعرّف المستند يجب أن يساوي معرّف الطالب نفسه، فلا يمكن كتابة عضو
      // مزيّف باسم طالب آخر. ويُشترط أيضًا:
      //   - `groupId` داخل المستند يساوي مسار المجموعة (ربط صريح لا يُزوَّر)،
      //   - ألّا تتجاوز العضوية سعة المجموعة (A-71)،
      //   - وحقول أثر النقل (`movedAt` / `movedFromGroupTitle`) اختيارية
      //     ومقيّدة النوع والحجم — يكتبها التطبيق وحده في معاملة النقل.
      match /members/{memberId} {
        function parentTeacherId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        allow read: if isAdmin()
          || (signedIn() && request.auth.uid == parentTeacherId());

        // في معاملة/دفعة، تُقيَّم القواعد على **الحالة بعد الكتابة**، فشرط
        // «مقعد حر» قبل الكتابة كان سيرفض حجز **المقعد الأخير** نفسه (لحظة
        // الاكتمال). لذلك نفحص ألّا تتجاوز العضوية السعة بعد التنفيذ؛ أما
        // ضمان «مقعد واحد مقابل كل حجز» فهو حصرًا في قاعدتي studyGroups
        // (ب) و(ج) — زيادة/نقصان **واحد بالضبط** بلا تغيير أي حقل آخر.
        function parentWithinCapacity() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken <= get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
        }

        allow create: if isAdmin() || (
          signedIn()
          && request.auth.uid == parentTeacherId()
          && memberId == request.resource.data.studentId
          && request.resource.data.keys().hasOnly(
               ['studentId', 'groupId', 'name', 'joinedAt', 'status',
                'movedAt', 'movedFromGroupTitle'])
          && (!('movedAt' in request.resource.data.keys())
              || request.resource.data.movedAt is timestamp)
          && (!('movedFromGroupTitle' in request.resource.data.keys())
              || (request.resource.data.movedFromGroupTitle is string
                  && request.resource.data.movedFromGroupTitle.size() <= 80))
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && parentWithinCapacity()
        );

        // التعديل إداري فقط (لا حالة عضو تُكتب من التطبيق).
        allow update: if isAdmin();

        // الإزالة (P9): صاحب المجموعة أو الإدارة. الحذف وحده لا يكفي — التطبيق
        // ينقص seatsTaken في المعاملة نفسها، وقاعدة studyGroups (ج) تسمح بمقعد
        // واحد فقط، فلا يمكن «حذف عضو» دون تحرير مقعده ولا العكس.
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == parentTeacherId());
      }

      // ── P9: الجدول الأسبوعي ──────────────────────────────────────────────
      // القراءة: صاحب المجموعة وكل عضو مقبول. الكتابة: صاحب المجموعة فقط.
      match /sessions/{sessionId} {
        function groupOwnerId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        function isOwner() {
          return signedIn() && request.auth.uid == groupOwnerId();
        }

        function isMember() {
          return signedIn() && exists(/databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid));
        }

        function sessionKeys() {
          return ['groupId', 'teacherId', 'title', 'weekday', 'startMinutes',
                  'durationMinutes', 'locationNote', 'isCancelled', 'createdAt'];
        }

        // نفس حدود العميل (SessionRules)، والحصة لا تعبر منتصف الليل.
        function validSession() {
          return request.resource.data.title is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 60
            && request.resource.data.weekday in ['saturday', 'sunday', 'monday',
                 'tuesday', 'wednesday', 'thursday', 'friday']
            && request.resource.data.startMinutes is int
            && request.resource.data.startMinutes >= 0
            && request.resource.data.startMinutes <= 1380
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 15
            && request.resource.data.durationMinutes <= 240
            && request.resource.data.startMinutes + request.resource.data.durationMinutes <= 1440
            && request.resource.data.isCancelled is bool
            && request.resource.data.locationNote is string
            && request.resource.data.locationNote.size() <= 60;
        }

        allow read: if isAdmin() || isOwner() || isMember();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(sessionKeys())
          && request.resource.data.groupId == groupId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.isCancelled == false
          && validSession();

        // التعديل لا ينقل الموعد لمجموعة أخرى ولا يغيّر مالكه.
        allow update: if isOwner()
          && request.resource.data.keys().hasOnly(sessionKeys())
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.teacherId == resource.data.teacherId
          && validSession();

        // لا حذف من التطبيق: الإلغاء عبر isCancelled يحفظ سجل الجدول.
        allow delete: if isAdmin();
      }

      // ── P9: محادثة المجموعة ──────────────────────────────────────────────
      // نفس الجمهور: المالك والأعضاء المقبولون فقط. ولا تعديل ولا حذف بعد
      // الإرسال — سجل المحادثة للقراءة فقط بعد كتابته.
      match /messages/{messageId} {
        function groupOwnerId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        function isOwner() {
          return signedIn() && request.auth.uid == groupOwnerId();
        }

        function isMember() {
          return signedIn() && exists(/databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid));
        }

        allow read: if isAdmin() || isOwner() || isMember();

        // لا انتحال مرسل: senderId يجب أن يساوي uid الطالب، ولا يكتب إلا عضو
        // أو المالك. الطول والمفاتيح مقيدة، والوقت من العميل (خادم الزمن
        // الكامل يحتاج دالة — مقبول لأن الترتيب فقط هو المستخدم).
        allow create: if (isOwner() || isMember())
          && request.resource.data.keys().hasOnly(
               ['groupId', 'senderId', 'senderName', 'senderRole', 'text', 'sentAt'])
          && request.resource.data.groupId == groupId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.senderRole in ['student', 'teacher']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.sentAt is timestamp;

        allow update, delete: if isAdmin();
      }
    }

    // ── 4) groupJoinRequests/{requestId} — طلبات الانضمام (P8) ───────────────
    // المعرّف حتمي: `groupId_studentId`، فطلب واحد لكل طالب في كل مجموعة.
    // المالك منسوخ في المستند (teacherId) حتى تكون القراءة فحصًا على حقول
    // المستند نفسه بلا get() لكل سطر في القائمة.
    match /groupJoinRequests/{requestId} {
      function joinRequestKeys() {
        return ['groupId', 'groupTitle', 'teacherId', 'studentId',
                'studentName', 'status', 'requestedAt', 'decidedAt',
                'decidedBy'];
      }

      // سطر واحد لكل تعبير: أسهل في المراجعة، ولا يعتمد على متابعة السطر.
      function groupIsActive(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.isActive == true;
      }

      function groupHasFreeSeat(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken < get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
      }

      function groupIsJoinable(groupId) {
        return groupIsActive(groupId) && groupHasFreeSeat(groupId);
      }

      function validNewRequest() {
        return request.resource.data.groupId is string
          && request.resource.data.groupTitle is string
          && request.resource.data.groupTitle.size() >= 3
          && request.resource.data.groupTitle.size() <= 80
          && request.resource.data.teacherId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 80
          && request.resource.data.requestedAt is timestamp
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(joinRequestKeys());
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.studentId == request.auth.uid
             || resource.data.teacherId == request.auth.uid
           ));

      // الطالب ينشئ طلبه فقط، لطالب مسجّل، لمجموعة منشورة بها مقعد، وبمعرّف
      // المستند المشتق. لا يستطيع كتابة حالة غير pending ولا نسب الطلب لمدرس آخر.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && requestId == request.resource.data.groupId + '_' + request.auth.uid
        && validNewRequest()
        && groupIsJoinable(request.resource.data.groupId)
        && request.resource.data.teacherId == get(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)).data.teacherId
        && request.resource.data.teacherId != request.auth.uid;

      // (أ) قرار المدرس: pending ← accepted/rejected، وبلا لمس أي حقل آخر.
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);

      // (ب) إلغاء الطالب لطلبه المعلّق — الحالة فقط.
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // (ج) إعادة الطلب بعد رفض/إلغاء: نفس المستند يعود pending، بشرط أن
      // تكون المجموعة ما زالت منشورة وبها مقعد (السعة تُفحص من جديد).
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status in ['rejected', 'cancelled']
        && validNewRequest()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == resource.data.teacherId
        && groupIsJoinable(resource.data.groupId);

      // حذف السجل (P9): صاحب المجموعة، **وفقط للصفوف المفتوحة**
      // (`pending`/`accepted`). يُستخدم في معاملة نقل العضو: صفوف المجموعة
      // المصدر تُحذف بعد خروج العضو، فلا يبقى طلب «مقبول» لطالب خارجها.
      //
      // لماذا شرط الحالة لا فحص العضوية؟ لأن `exists()` في معاملة يقرأ الحالة
      // **قبل** الكتابة، فشرط «ليس عضوًا» كان يرفض حذف نفس السجل في المعاملة
      // التي تُخرجه من العضوية (تحقّق على المحاكي). وشرط الحالة بلا أي قراءة
      // مستندات: يحمي تاريخ الطلبات المغلقة (مرفوض/ملغى) من المحو، ويترك
      // الصفوف المفتوحة للمالك ينظّفها.
      allow delete: if isAdmin() || (
        signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status in ['pending', 'accepted']
      );
    }

    // ── 4-ب) groupWaitlist/{entryId} — قائمة انتظار المجموعة المكتملة (P9) ──
    // المعرّف حتمي: `groupId_studentId`، فصف واحد لكل طالب في كل مجموعة.
    // **المنتظر ليس عضوًا**: لا مستند في members، فلا يقرأ الجدول ولا المحادثة.
    match /groupWaitlist/{entryId} {
      function waitlistKeys() {
        return ['groupId', 'groupTitle', 'teacherId', 'studentId',
                'studentName', 'status', 'addedAt', 'decidedAt', 'decidedBy'];
      }

      function groupIsActive(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.isActive == true;
      }

      function groupIsFull(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken >= get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
      }

      function groupOwnerId(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
      }

      function validNewEntry() {
        return request.resource.data.groupId is string
          && request.resource.data.groupTitle is string
          && request.resource.data.groupTitle.size() >= 3
          && request.resource.data.groupTitle.size() <= 80
          && request.resource.data.teacherId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 80
          && request.resource.data.addedAt is timestamp
          && request.resource.data.status == 'waiting'
          && request.resource.data.keys().hasOnly(waitlistKeys());
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.studentId == request.auth.uid
             || resource.data.teacherId == request.auth.uid
           ));

      // الطالب يضيف نفسه فقط، لمجموعة **مكتملة** ومنشورة، وبمعرّف مشتق.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && entryId == request.resource.data.groupId + '_' + request.auth.uid
        && validNewEntry()
        && groupIsActive(request.resource.data.groupId)
        && groupIsFull(request.resource.data.groupId)
        && request.resource.data.teacherId == groupOwnerId(request.resource.data.groupId)
        && request.resource.data.teacherId != request.auth.uid;

      // (أ) المدرس يقبل منتظرًا: waiting ← promoted، وبلا لمس أي حقل آخر.
      // زيادة المقعد تحدث بتعديل منفصل على المجموعة تقبله القاعدة (ب).
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'promoted'
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);

      // (ب) الطالب يغادر الطابور — الحالة فقط، وبلا قرار مدرس.
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'left'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // (ج) العودة بعد المغادرة: الصف نفسه يعود waiting، بشرط أن تكون المجموعة
      // ما زالت مكتملة ومنشورة (تُفحص من جديد، لا اعتمادًا على الحالة القديمة).
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'left'
        && validNewEntry()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == resource.data.teacherId
        && resource.data.teacherId == groupOwnerId(resource.data.groupId)
        && groupIsActive(resource.data.groupId)
        && groupIsFull(resource.data.groupId);

      // حذف الصف (P9): صاحب المجموعة، وفقط للصفوف المفتوحة
      // (`waiting`/`promoted`). نفس منطق طلبات الانضمام وسيببه نفسه (قراءة
      // المعاملة تسبق الكتابة)، ولا أثر على المقاعد.
      allow delete: if isAdmin() || (
        signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status in ['waiting', 'promoted']
      );
    }

    // ── 5) bookingRequests/{bookingId} — الحجوزات (P10) ──────────────────────
    // القراءة لطرفي الطلب فقط. الإنشاء للطالب، والقرار للمدرس، والإلغاء
    // للطرفين، وكل انتقال مقيّد بقائمة الحقول المسموح بتغييرها (A-75).
    //
    // **ما لا تستطيع القواعد فرضه:** تقاطع المواعيد (تحتاج استعلامًا). لذلك
    // يوجد مستند تقويم يومي لكل مدرس (5-ب) تكتبه المعاملة نفسها، وكشف التعارض
    // في الطبقة الوسطى. القواعد تمنع أن يكتب التقويمَ غيرُ المدرس، أو أن يضيف
    // أحدٌ حجزًا دون قرار مدرس.
    match /bookingRequests/{bookingId} {
      function bookingKeys() {
        return ['teacherId', 'teacherName', 'studentId', 'studentName',
                'subject', 'note', 'status', 'requestedAt', 'dateKey',
                'startMinutes', 'durationMinutes', 'decidedAt', 'decidedBy',
                'cancelledAt', 'cancelledBy', 'proposalDateKey',
                'proposalStartMinutes', 'proposedBy', 'proposedAt'];
      }

      function decisionKeys() {
        return ['status', 'decidedAt', 'decidedBy'];
      }

      function cancellationKeys() {
        return ['status', 'cancelledAt', 'cancelledBy'];
      }

      function proposalKeys() {
        return ['status', 'proposalDateKey', 'proposalStartMinutes',
                'proposedBy', 'proposedAt'];
      }

      // قبول اقتراح يحرّك الموعد إلى الوقت المقترح ويمسح حقول الاقتراح.
      function acceptanceAfterProposalKeys() {
        return ['status', 'decidedAt', 'decidedBy', 'dateKey', 'startMinutes',
                'durationMinutes', 'proposalDateKey', 'proposalStartMinutes',
                'proposedBy', 'proposedAt'];
      }

      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function validSlot() {
        return request.resource.data.durationMinutes in [30, 45, 60, 90, 120]
          && request.resource.data.startMinutes is int
          && request.resource.data.startMinutes >= 480
          && request.resource.data.startMinutes + request.resource.data.durationMinutes <= 1320
          && request.resource.data.dateKey is string
          && request.resource.data.dateKey.size() == 10;
      }

      function validProposal() {
        return request.resource.data.proposalStartMinutes is int
          && request.resource.data.proposalStartMinutes >= 480
          && request.resource.data.proposalStartMinutes + resource.data.durationMinutes <= 1320
          && request.resource.data.proposalDateKey is string
          && request.resource.data.proposalDateKey.size() == 10
          && request.resource.data.proposedAt is timestamp;
      }

      function isRequesterTeacher() {
        return signedIn() && resource.data.teacherId == request.auth.uid;
      }

      function isRequesterStudent() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      allow read: if isAdmin()
        || (signedIn() && (
             request.auth.uid == resource.data.studentId
             || request.auth.uid == resource.data.teacherId
           ));

      // الإنشاء: الطالب لنفسه، لمدرس آخر، بحالة pending وموعد صالح.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId is string
        && request.resource.data.teacherId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 80
        && request.resource.data.studentName is string
        && request.resource.data.teacherName is string
        && (!('note' in request.resource.data.keys())
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 200))
        && validSlot()
        && request.resource.data.keys().hasOnly(bookingKeys());

      // (أ) ردّ المدرس على اقتراح وقت بديل: قبول (يصبح الوقت المقترح هو
      // الموعد — نتحقق أنه هو نفسه) أو رفض (يُنهي الطلب).
      allow update: if isRequesterTeacher()
        && resource.data.status == 'rescheduleProposed'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && changedOnly(acceptanceAfterProposalKeys())
        && (
             request.resource.data.status == 'rejected'
             || (
                  request.resource.data.dateKey == resource.data.proposalDateKey
                  && request.resource.data.startMinutes == resource.data.proposalStartMinutes
                )
           );

      // (أ-٢) ردّ الطالب على اقتراح المدرس — نفس الشرطين بالضبط، بالدور الآخر.
      allow update: if isRequesterStudent()
        && resource.data.status == 'rescheduleProposed'
        && resource.data.proposedBy == 'teacher'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && changedOnly(acceptanceAfterProposalKeys())
        && (
             request.resource.data.status == 'rejected'
             || (
                  request.resource.data.dateKey == resource.data.proposalDateKey
                  && request.resource.data.startMinutes == resource.data.proposalStartMinutes
                )
           );

      // (ب) المدرس يقبل طلبًا معلّقًا بلا اقتراح (الحقول الأساسية كما هي).
      allow update: if isRequesterTeacher()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && changedOnly(decisionKeys());

      // (ج) المدرس يرفض طلبًا معلّقًا — بلا أي تغيير في الموعد المطلوب.
      allow update: if isRequesterTeacher()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && changedOnly(decisionKeys());

      // (د) اقتراح وقت بديل: من أي طرف، لطلب معلّق أو مؤكد، بموعد صالح.
      allow update: if (isRequesterTeacher() || isRequesterStudent())
        && resource.data.status in ['pending', 'accepted']
        && request.resource.data.status == 'rescheduleProposed'
        && request.resource.data.proposedBy in ['teacher', 'student']
        && validProposal()
        && changedOnly(proposalKeys());

      // (هـ) إلغاء: من أي طرف، والحالة تُصنَّف مبكرًا/متأخرًا في الطبقة الوسطى
      // (التصنيف للعرض لا يمنح صلاحية، فالقواعد تقبل الحالتين).
      allow update: if (isRequesterTeacher() || isRequesterStudent())
        && resource.data.status in ['pending', 'accepted', 'rescheduleProposed']
        && request.resource.data.status in ['cancelled', 'cancelledLate']
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt is timestamp
        && changedOnly(cancellationKeys());

      // (و) إعلان التنفيذ: المدرس وحده، ولموعد مؤكد.
      allow update: if isRequesterTeacher()
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'completed'
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && changedOnly(decisionKeys());

      // لا حذف: سجل الحجز يبقى بعد الإلغاء.
      allow delete: if isAdmin();
    }

    // ── 5-ب) teacherCalendar/{teacherId_dateKey} — تقويم يومي (P10) ──────────
    // مستند واحد لكل مدرس/يوم يحمل فترات محجوزة. وجوده يجعل قرار القبول
    // وقراءة التقويم في معاملة واحدة، فيتسلسل القبولان المتزامنان (A-76).
    //
    // المالك يضيف/يحدّث، وأي مسجّل يستطيع **الحذف فقط** (لأن الطالب يلغي
    // حجزه بنفسه فيحرّر وقته). الحذف لا يضيف وقتًا ولا يغيّر المالك.
    match /teacherCalendar/{calendarId} {
      function busyKeys() {
        return ['teacherId', 'dateKey', 'busy'];
      }

      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.dateKey is string
        && request.resource.data.busy is map
        && request.resource.data.keys().hasOnly(busyKeys());

      allow update: if signedIn()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.keys().hasOnly(busyKeys())
        && request.resource.data.busy is map
        && (
             // (أ) المدرس صاحب التقويم: يضيف أو يحرّر أي فترة.
             request.auth.uid == resource.data.teacherId
             // (ب) غيره: **إزالة فقط** — لا يزيد حجم الخريطة ولا يضيف مفاتيح.
             || (
                  request.resource.data.busy.size() <= resource.data.busy.size()
                  && request.resource.data.busy.keys().hasOnly(resource.data.busy.keys())
                )
           );

      allow delete: if isAdmin();
    }

    // ── 6) teacherSettings/{teacherId} — خصوصية المدرس (P11) ─────────────────
    // قرار واحد صريح: هل يستقبل المدرس رسائل قبل الحجز؟ **غياب المستند يعني
    // الرفض** (A-78): لا نكتب القيمة الافتراضية نيابةً عن المدرس.
    //
    // القراءة لكل مسجّل: الطالب يحتاجها قبل أن يبادر، وهي قيمة منطقية واحدة
    // لا تكشف شيئًا آخر. الكتابة لصاحبها فقط وبحقلين محددين.
    match /teacherSettings/{teacherId} {
      allow read: if isAdmin() || signedIn();

      allow create, update: if isSelf(teacherId)
        && request.resource.data.keys().hasOnly(
             ['allowDirectMessages', 'updatedAt'])
        && request.resource.data.allowDirectMessages is bool
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // ── 7) directChats/{chatId} — محادثات مباشرة (P11) ───────────────────────
    // **الخيط مشتق من الطرفين:** `chatId == teacherId + '_' + studentId`، فلا
    // يمكن إنشاء محادثة مزيّفة أو خيط ثانٍ لنفس الزوج.
    //
    // الأصل الموثّق إجباري، وواحد فقط:
    //   - `booking`: يوجد حجز بين الطرفين فعلًا، وحالته ليست الرفض.
    //   - `group`: الطالب عضو (exists على مستند العضوية) عند هذا المدرس.
    //   - `inquiry`: المدرس فعّل `allowDirectMessages` (غياب الإعداد = رفض).
    //
    // القراءة للطرفين فقط، والرسائل في المجموعة الفرعية تُورَّث بالفحص نفسه.
    match /directChats/{chatId} {
      function chatKeys() {
        return ['teacherId', 'teacherName', 'studentId', 'studentName',
                'subject', 'origin', 'bookingId', 'groupId', 'createdAt',
                'lastMessageAt', 'lastMessageText', 'lastSenderId',
                'studentLastReadAt', 'teacherLastReadAt'];
      }

      function isParticipant() {
        return signedIn() && (
          request.auth.uid == resource.data.teacherId
          || request.auth.uid == resource.data.studentId
        );
      }

      function isCreatorParticipant() {
        return signedIn() && (
          request.auth.uid == request.resource.data.teacherId
          || request.auth.uid == request.resource.data.studentId
        );
      }

      function idMatchesParties() {
        return chatId == request.resource.data.teacherId + '_'
          + request.resource.data.studentId;
      }

      function commonPayload() {
        return signedIn()
          && isCreatorParticipant()
          && idMatchesParties()
          && request.resource.data.teacherId != request.resource.data.studentId
          && request.resource.data.keys().hasOnly(chatKeys())
          && request.resource.data.origin is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.teacherName is string
          && request.resource.data.teacherName.size() > 0
          && request.resource.data.teacherName.size() <= 80
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 80
          && (!('subject' in request.resource.data.keys())
              || (request.resource.data.subject is string
                  && request.resource.data.subject.size() <= 80));
      }

      function bookingOfChat() {
        return get(/databases/$(database)/documents/bookingRequests/$(request.resource.data.bookingId)).data;
      }

      function teacherSettingsDoc() {
        return get(/databases/$(database)/documents/teacherSettings/$(request.resource.data.teacherId)).data;
      }

      allow read: if isAdmin() || isParticipant();

      // (أ) خيط مرتبط بحجز: الطالب أو المدرس، والحجز يخصّ الطرفين معًا.
      allow create: if commonPayload()
        && request.resource.data.origin == 'booking'
        && request.resource.data.bookingId is string
        && !('groupId' in request.resource.data.keys())
        && bookingOfChat().studentId == request.resource.data.studentId
        && bookingOfChat().teacherId == request.resource.data.teacherId
        && bookingOfChat().status in ['pending', 'accepted', 'rescheduleProposed',
                                      'completed', 'cancelled', 'cancelledLate'];

      // (ب) خيط عضو مجموعة: العضوية موجودة، والمجموعة لهذا المدرس نفسه.
      allow create: if commonPayload()
        && request.resource.data.origin == 'group'
        && request.resource.data.groupId is string
        && !('bookingId' in request.resource.data.keys())
        && exists(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)/members/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)).data.teacherId == request.resource.data.teacherId;

      // (ج) استفسار قبل الحجز: الطالب ينشئه، **والمدرس فعّل** الخيار.
      allow create: if commonPayload()
        && request.resource.data.origin == 'inquiry'
        && request.resource.data.studentId == request.auth.uid
        && !('bookingId' in request.resource.data.keys())
        && !('groupId' in request.resource.data.keys())
        && teacherSettingsDoc().allowDirectMessages == true;

      // (د) حالة القراءة: كل طرف يكتب حقلَه وحده، ولا يمسّ شيئًا آخر.
      // `size() > 0` ضروري: كتابة القيمة نفسها لا تُنتج فروقًا، فتنجح
      // `hasOnly` على مجموعة فارغة — وهذا منفذ لكتابة «لا شيء» باسم القراءة.
      allow update: if isParticipant()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0
        && (
             (request.auth.uid == resource.data.studentId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentLastReadAt'])
              && request.resource.data.studentLastReadAt is timestamp)
             ||
             (request.auth.uid == resource.data.teacherId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherLastReadAt'])
              && request.resource.data.teacherLastReadAt is timestamp)
           );

      // (هـ) ملخّص آخر رسالة: يكتبه مرسل الرسالة نفسه فقط، بعدها في الدفعة
      // نفسها. لا يغيّر الأطراف ولا الأصل، ولا يُرجِع الزمن للخلف.
      //
      // **حدّ معروف:** القواعد لا تستطيع إثبات أن الرسالة كُتبت في نفس الدفعة
      // (`get` يرى ما قبلها)، فمنعنا هنا ما يضر: لا ينتحل المرسل، ولا يغيّر
      // إلا ثلاثة حقول، ولا يعرض نصًا أطول من حدّه. النص نفسه في مجموعة
      // الرسائل محكوم بقاعدة القراءة/الكتابة الخاصة بها.
      allow update: if isParticipant()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageAt >= resource.data.get('lastMessageAt', timestamp.value(0))
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        && request.resource.data.lastMessageText.size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['lastMessageAt', 'lastMessageText', 'lastSenderId']);

      // لا حذف من التطبيق: المحادثة سجل، والحذف قرار إداري.
      allow delete: if isAdmin();

      // ── 7-ب) رسائل المحادثة ─────────────────────────────────────────────
      // القراءة للطرفين فقط، والكتابة لمرسِل يساوي معرّفه `uid`، وبشرط أن
      // يظل المحتوى مسموحًا: استفسار أُوقف استقباله، أو حجز مرفوض، يمنعان
      // **الجديد** ولا يمسحان القديم (سجل يُقرأ ولا يُعاد كتابته).
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/directChats/$(chatId)).data;
        }

        function viewerIsParticipant() {
          return signedIn() && (
            request.auth.uid == parentChat().teacherId
            || request.auth.uid == parentChat().studentId
          );
        }

        function channelAllowsSending() {
          return (parentChat().origin == 'booking'
                  && get(/databases/$(database)/documents/bookingRequests/$(parentChat().bookingId)).data.status != 'rejected')
            || parentChat().origin == 'group'
            || (parentChat().origin == 'inquiry'
                && get(/databases/$(database)/documents/teacherSettings/$(parentChat().teacherId)).data.allowDirectMessages == true);
        }

        allow read: if isAdmin() || viewerIsParticipant();

        allow create: if viewerIsParticipant()
          && channelAllowsSending()
          && request.resource.data.keys().hasOnly(
               ['chatId', 'senderId', 'senderName', 'senderRole', 'text', 'sentAt'])
          && request.resource.data.chatId == chatId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.senderRole in ['student', 'teacher']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.sentAt is timestamp;

        allow update, delete: if isAdmin();
      }
    }

    // ── 9) notifications/{notificationId} — إشعارات داخل التطبيق (P12) ───────
    // **لمن؟** مستند واحد لمستلم واحد. القراءة والتعليم والحذف للمستلم فقط،
    // والإدارة.
    //
    // **الإنشاء:** يكتبه الطرف الذي نفّذ الفعل (`actorId == request.auth.uid`)،
    // لأن المشروع لا يستخدم Cloud Functions (تحتاج خطة Blaze). القواعد هي
    // الحارس: تتحقق من علاقة حقيقية بين المُحدِث والمستلم، ومن أن النوع يطابق
    // حالة الكيان المقصود — فلا يمكن تزوير إشعار «قُبل حجزك» لحجز معلّق، ولا
    // مراسلة شخص لا توجد بينك وبينه علاقة.
    //
    // **حدّ معروف:** العنوان والنص يكتبهما العميل (بالعربية، وبحدود طول)، لأن
    // ترجمتها في الخادم تحتاج دالة سحابية. ما يهم — النوع والوجهة والمستلم —
    // مفحوص، والنص للعرض فقط.
    match /notifications/{notificationId} {
      function notificationKeys() {
        return ['recipientId', 'type', 'actorId', 'actorName', 'targetId',
                'title', 'body', 'createdAt', 'readAt'];
      }

      function bookingOfNotification() {
        return get(/databases/$(database)/documents/bookingRequests/$(request.resource.data.targetId)).data;
      }

      function chatOfNotification() {
        return get(/databases/$(database)/documents/directChats/$(request.resource.data.targetId)).data;
      }

      function groupOfNotification() {
        return get(/databases/$(database)/documents/studyGroups/$(request.resource.data.targetId)).data;
      }

      function validText() {
        return request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() > 0
          && request.resource.data.actorName.size() <= 80
          && (!('body' in request.resource.data.keys())
              || (request.resource.data.body is string
                  && request.resource.data.body.size() > 0
                  && request.resource.data.body.size() <= 200));
      }

      // نوع الحجز يجب أن يطابق الحالة الفعلية، حتى لا يُزعم «قُبل» أو «رُفض»
      // قبل حدوثه.
      function bookingTypeMatchesStatus() {
        return (request.resource.data.type == 'bookingRequested'
                && bookingOfNotification().status == 'pending')
          || (request.resource.data.type == 'bookingAccepted'
                && bookingOfNotification().status == 'accepted')
          || (request.resource.data.type == 'bookingRejected'
                && bookingOfNotification().status == 'rejected')
          || (request.resource.data.type == 'rescheduleProposed'
                && bookingOfNotification().status == 'rescheduleProposed');
      }

      // طرفا الحجز: أحدهما المستلم والآخر المُحدِث (لا إشعار لنفسك).
      function bookingPartiesMatch() {
        return request.resource.data.recipientId in [
                 bookingOfNotification().studentId,
                 bookingOfNotification().teacherId
               ]
          && request.auth.uid in [
               bookingOfNotification().studentId,
               bookingOfNotification().teacherId
             ];
      }

      // طرفا المحادثة: كلاهما مشارك، أحدهما المستلم والآخر المُحدِث.
      function chatPartiesMatch() {
        return request.resource.data.recipientId in [
                 chatOfNotification().studentId,
                 chatOfNotification().teacherId
               ]
          && request.auth.uid in [
               chatOfNotification().studentId,
               chatOfNotification().teacherId
             ];
      }

      allow read: if isAdmin() || (signedIn() && isSelf(resource.data.recipientId));

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.createdAt is timestamp
        && !('readAt' in request.resource.data.keys())
        && request.resource.data.keys().hasOnly(notificationKeys())
        && validText()
        && (
             // (أ) إشعارات الحجز: النوع يطابق الحالة، والطرفان هما المستلم
             // والمُحدِث.
             (request.resource.data.type in ['bookingRequested', 'bookingAccepted',
                                             'bookingRejected', 'rescheduleProposed']
              && bookingTypeMatchesStatus()
              && bookingPartiesMatch())
             // (ب) رسالة مباشرة: المُحدِث مرسل داخل المحادثة، والمستلم طرفها
             // الآخر.
             || (request.resource.data.type == 'directMessage'
                 && chatPartiesMatch())
             // (ج) ترقية من قائمة الانتظار: المالك يُشعر عضوًا صار له مقعد.
             || (request.resource.data.type == 'waitlistPromoted'
                 && groupOfNotification().teacherId == request.auth.uid
                 && exists(/databases/$(database)/documents/studyGroups/$(request.resource.data.targetId)/members/$(request.resource.data.recipientId)))
           );

      // تعليم مقروء: المستلم وحده، وحقل واحد فقط. `size() > 0` تمنع كتابة
      // القيمة نفسها (فروق فارغة).
      allow update: if signedIn()
        && isSelf(resource.data.recipientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0
        && request.resource.data.readAt is timestamp;

      allow delete: if isAdmin() || (signedIn() && isSelf(resource.data.recipientId));
    }

    // ── 10) reviews/{reviewId} — تقييم بعد حصة منفّذة (P13) ──────────────────
    // **معرّف التقييم = معرّف الحجز** (A-84): به يمنع التكرار بنيويًا، وتقرأ
    // القواعد الحجز نفسه لتتحقق من بوابة الأهلية G7 بلا استعلام.
    //
    // **لماذا لا تعديل ولا حذف؟** لأن التقييم شهادة على حصة عُقدت. ومنع التعديل
    // يمنع أيضًا «تبديل» تقييم سيئ بآخر بعد ضغط من المدرس.
    match /reviews/{reviewId} {
      function bookingOfReview() {
        return get(/databases/$(database)/documents/bookingRequests/$(reviewId)).data;
      }

      function reviewKeys() {
        return ['bookingId', 'teacherId', 'studentId', 'studentName', 'rating',
                'comment', 'createdAt'];
      }

      // التقييمات عامة للمسجّلين: ملف المدرس يعرضها لكل من يفكر في الحجز.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.bookingId == reviewId
        && request.resource.data.keys().hasOnly(reviewKeys())
        && request.resource.data.teacherId is string
        && request.resource.data.teacherId.size() > 0
        && request.resource.data.teacherId.size() <= 128
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('comment' in request.resource.data.keys())
            || (request.resource.data.comment is string
                && request.resource.data.comment.size() > 0
                && request.resource.data.comment.size() <= 400))
        && request.resource.data.createdAt is timestamp
        // G7: الحجز منفّذ، لصاحب التقييم، وبنفس المدرس، وباسم منسوخ منه.
        && bookingOfReview().status == 'completed'
        && bookingOfReview().studentId == request.auth.uid
        && bookingOfReview().teacherId == request.resource.data.teacherId
        && bookingOfReview().studentName == request.resource.data.studentName;

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ── 11) teacherRatings/{teacherId} — المتوسط التراكمي (P13) ──────────────
    // **مجموع + عدد، لا متوسط عشري** (A-85): الحساب العشري لا يُتحقق منه بدقة
    // في القواعد، والصحيح يُتحقق منه بالمساواة. و`getAfter()` تقرأ التقييم
    // المنشأ في نفس الدفعة/المعاملة، فتُقارن الزيادة بتقييمه بالضبط.
    match /teacherRatings/{teacherId} {
      function reviewOfAggregate() {
        return getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data;
      }

      function ratingKeys() {
        return ['teacherId', 'totalReviews', 'ratingSum', 'lastReviewId',
                'updatedAt'];
      }

      allow read: if signedIn();

      // أول تقييم: مستند جديد يبدأ من 1 ومجموعه هو تقييم التقييم نفسه.
      allow create: if signedIn()
        && request.resource.data.teacherId == teacherId
        && request.resource.data.keys().hasOnly(ratingKeys())
        && request.resource.data.totalReviews == 1
        && request.resource.data.ratingSum is int
        && request.resource.data.lastReviewId is string
        && request.resource.data.updatedAt is timestamp
        && !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId))
        && reviewOfAggregate().teacherId == teacherId
        && reviewOfAggregate().studentId == request.auth.uid
        && reviewOfAggregate().rating == request.resource.data.ratingSum;

      // تقييم لاحق: زيادة **واحدة**، ومجموعها القديم + تقييم التقييم الجديد
      // وحده. و`!exists()` تمنع إعادة استخدام تقييم قديم لزيادة جديدة.
      allow update: if signedIn()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.keys().hasOnly(ratingKeys())
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.totalReviews == resource.data.totalReviews + 1
        && request.resource.data.ratingSum
             == resource.data.ratingSum + reviewOfAggregate().rating
        && request.resource.data.lastReviewId != resource.data.lastReviewId
        && !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId))
        && reviewOfAggregate().teacherId == teacherId
        && reviewOfAggregate().studentId == request.auth.uid;
    }

    // ── 12) favorites/{favoriteId} — مفضلة الطالب (P13) ──────────────────────
    // المعرّف مشتق: `{studentId}_{kind}_{targetId}` (A-86)، فلا تكرار، وحذف
    // بلا بحث. والهدف يجب أن يكون **قائمًا** بالفعل: مدرس معتمد أو مجموعة نشطة.
    match /favorites/{favoriteId} {
      function favoriteKeys() {
        return ['studentId', 'kind', 'targetId', 'createdAt'];
      }

      allow read: if isAdmin() || (signedIn() && isSelf(resource.data.studentId));

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly(favoriteKeys())
        && request.resource.data.kind in ['teacher', 'group']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.createdAt is timestamp
        && favoriteId == request.resource.data.studentId + '_' + request.resource.data.kind + '_' + request.resource.data.targetId
        && (
             (request.resource.data.kind == 'teacher'
              && get(/databases/$(database)/documents/teacherProfiles/$(request.resource.data.targetId)).data.status == 'approved')
             || (request.resource.data.kind == 'group'
                 && get(/databases/$(database)/documents/studyGroups/$(request.resource.data.targetId)).data.isActive == true)
           );

      allow delete: if isAdmin() || (signedIn() && isSelf(resource.data.studentId));
    }

    // ── 13) كل ما لم يُذكر: ممنوع ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
