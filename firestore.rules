rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// قواعد أمان Firestore — تطبيق «درسلي»
//
// السياسة المعتمدة (A-42، 2026-10-27):
//   1. users/{uid}: قراءة/كتابة لصاحبه فقط، والدور لا يتغيّر بعد الكتابة الأولى.
//   2. teacherProfiles/{uid}: القراءة العامة للملفات المعتمدة فقط؛ صاحبه يرى
//      ملفه بكل حالاته ولا يستطيع تغيير status.
//   3. لا وصول إداري من التطبيق: الاعتماد والتمييز بأدوات إدارية خارجية
//      (Firebase Console أو سكربت بمفتاح خدمة لا يصل للتطبيق).
//   4. المجموعات (P7) وصاحبها فقط يكتب، والطلبات (P8) لكل طالب طلبه الواحد،
//      وحجز المقعد زيادة واحدة ذرّية يقبلها الخادم لا الواجهة.
//   5. الجدول والمحادثة (P9): يقرأهما صاحب المجموعة والأعضاء المقبولون فقط
//      (`exists()` على مستند العضو)، ويكتب الجدول المالك وحده، ولا رسالة
//      تُعدَّل أو تُحذف بعد إرسالها.
//   6. قائمة الانتظار (P9): للمجموعة **المكتملة** فقط، والمنتظر لا يشغل مقعدًا
//      ولا يرى الجدول/المحادثة. إزالة عضو تنقص المقعد، وقبول منتظر يزيده —
//      كلاهما بمعاملة، والقواعد تحدّ الفرق بمقعد واحد في الاتجاهين.
//   7. سعة المجموعة (P9): حدّ **صارم 40**، ولا تُقلَّب تحت المنضمين، ولا
//      تتغيّر مع seatsTaken في كتابة واحدة. والنقل بين مجموعتين يحرّك مقعدًا
//      في كل اتجاه ويُنشئ عضوية تحمل groupId مطابقًا لمسارها.
//
// المبدأ الحاكم: **كل شيء ممنوع إلا ما نُصّ عليه**. القاعدة الأخيرة ترفض أي
// مجموعة مستندات غير مذكورة، حتى لو أضافها كود لاحقًا بالخطأ.
//
// ⚠️ هذه القواعد لم تُنشر بعد. النشر يتم من صاحب المشروع (انظر docs/P5_FIRESTORE.md).
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // حساب إداري: يُمنح فقط عبر Custom Claim يُضبط بمفتاح خدمة خارج التطبيق.
    // التطبيق لا يستطيع منح نفسه هذا الادعاء إطلاقًا.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ── 1) users/{uid} ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'role', 'createdAt', 'roleChosenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // الدور ثابت: أي محاولة لتغييره تُرفض. بقية الحقول (الاسم/البريد) يجوز
      // تحديثها، والحقول غير المعروفة مرفوضة.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'role', 'createdAt', 'roleChosenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // لا حذف من التطبيق: حذف الحساب إجراء إداري (سياسة الاحتفاظ T-10).
      allow delete: if isAdmin();
    }

    // ── 2) teacherProfiles/{uid} ─────────────────────────────────────────────
    match /teacherProfiles/{uid} {
      // القراءة: الملف المعتمد للجميع، وصاحبه يرى ملفه بأي حالة.
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || isSelf(uid);

      // الإنشاء: صاحبه فقط، وبداية دورة المراجعة إجبارية.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pendingReview'
        && request.resource.data.ownerId == uid
        && request.resource.data.keys().hasOnly(
             ['ownerId', 'displayName', 'status', 'createdAt',
              'subject', 'stage', 'area', 'bio', 'priceHint'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;

      // التحديث: صاحبه يعدّل حقوله الوصفية فقط.
      // - status و ownerId ثابتان (يُضبطان إداريًا أو عند الإنشاء).
      // - isFeatured و rating و reviewsCount غير مذكورة في hasOnly ⇒ لا يكتبها
      //   التطبيق إطلاقًا.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly(
             ['ownerId', 'displayName', 'status', 'createdAt',
              'subject', 'stage', 'area', 'bio', 'priceHint'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
      );

      // لا حذف من التطبيق.
      allow delete: if isAdmin();
    }

    // ── 3) studyGroups/{groupId} ─────────────────────────────────────────────
    // القراءة: النشِطة للمسجّلين، وصاحبها يرى الموقوفة.
    // الكتابة: **المدرس صاحب المجموعة فقط** (P7): إنشاء/تعديل/إيقاف.
    // لا حذف من التطبيق — الإيقاف عبر isActive بدل فقدان سجل الطلاب.
    match /studyGroups/{groupId} {
      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.teacherId;
      }

      function validGroupPayload() {
        return request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 40
          && request.resource.data.stage is string
          && request.resource.data.stage.size() > 0
          && request.resource.data.stage.size() <= 40
          && request.resource.data.teacherName is string
          && request.resource.data.teacherName.size() > 0
          && request.resource.data.teacherName.size() <= 80
          && request.resource.data.meetingMode in ['online', 'home', 'center']
          && request.resource.data.isActive is bool;
      }

      // السعة: عدد صحيح بين 2 و**40 حدًّا صارمًا** (A-70)، ولا تقل عن المنضمين.
      // هذا الفحص يغطي تعديل السعة في أي وقت، ويبقى seatsTaken مشدودًا في
      // قاعدة التعديل العامة (أ): أي محاولة لتغيير الاثنين معًا تُرفض.
      function validSeats() {
        return request.resource.data.seatsTotal is int
          && request.resource.data.seatsTotal >= 2
          && request.resource.data.seatsTotal <= 40
          && request.resource.data.seatsTotal >= request.resource.data.seatsTaken;
      }

      function groupKeys() {
        return ['teacherId', 'teacherName', 'title', 'subject', 'stage',
                'seatsTotal', 'seatsTaken', 'meetingMode', 'scheduleNote',
                'isActive'];
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.isActive == true
             || request.auth.uid == resource.data.teacherId
           ));

      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(groupKeys())
        && request.resource.data.seatsTaken == 0
        && request.resource.data.isActive == true
        && validGroupPayload()
        && validSeats()
        && (
             !('scheduleNote' in request.resource.data.keys())
             || (request.resource.data.scheduleNote is string
                 && request.resource.data.scheduleNote.size() <= 120)
           );

      // (أ) تعديل البيانات العادي: المالك فقط، ولا يغيّر المالك ولا المقاعد
      // المشغولة. قبول الطلبات له قاعدة منفصلة (ب) لأن القواعد تُقيَّم كـOR.
      allow update: if isAdmin() || (
        isGroupOwner()
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.seatsTaken == resource.data.seatsTaken
        && request.resource.data.keys().hasOnly(groupKeys())
        && validGroupPayload()
        && validSeats()
        && (
             !('scheduleNote' in request.resource.data.keys())
             || (request.resource.data.scheduleNote is string
                 && request.resource.data.scheduleNote.size() <= 120)
           )
      );

      // (ب) حجز مقعد عند قبول طلب انضمام (P8) أو قبول منتظر أو **نقل عضو**
      // إلى هذه المجموعة (P9):
      //   - المالك فقط، والمجموعة منشورة.
      //   - **لا يتغيّر أي حقل آخر** غير seatsTaken (diff.hasOnly).
      //   - الزيادة **واحد بالضبط** ولا تتجاوز السعة الكلية.
      // وبما أن المعاملة تُعيد قراءة المستند، فإن قبولين متزامنين على المقعد
      // الأخير لا يمرّان: الثاني يرى seatsTaken مساويًا للسعة فيُرفض.
      allow update: if isGroupOwner()
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsTaken'])
        && request.resource.data.seatsTaken == resource.data.seatsTaken + 1
        && request.resource.data.seatsTaken <= resource.data.seatsTotal;

      // (ج) تحرير مقعد عند إزالة عضو **أو نقل عضو خارج المجموعة** (P9):
      //   - المالك فقط (يعمل مع المجموعة الموقوفة أيضًا: الإدارة لا تتوقف).
      //   - **لا يتغيّر أي حقل آخر** غير seatsTaken، والنقص واحد بالضبط.
      //   - لا يصبح العدد سالبًا.
      allow update: if isGroupOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsTaken'])
        && request.resource.data.seatsTaken == resource.data.seatsTaken - 1
        && request.resource.data.seatsTaken >= 0;

      allow delete: if isAdmin();
// (نص scheduleNote الفارغ مقبول: يعني «بلا موعد محدد».)

      // أعضاء المجموعة: المدرس صاحب المجموعة والإدارة فقط.
      // الطالب لا يرى أسماء بقية الطلاب (خصوصية).
      //
      // الإنشاء مسموح للمالك فقط لأنه يحدث داخل معاملة قبول الطلب أو النقل؛
      // ومعرّف المستند يجب أن يساوي معرّف الطالب نفسه، فلا يمكن كتابة عضو
      // مزيّف باسم طالب آخر. ويُشترط أيضًا:
      //   - `groupId` داخل المستند يساوي مسار المجموعة (ربط صريح لا يُزوَّر)،
      //   - ألّا تتجاوز العضوية سعة المجموعة (A-71).
      match /members/{memberId} {
        function parentTeacherId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        allow read: if isAdmin()
          || (signedIn() && request.auth.uid == parentTeacherId());

        // في معاملة/دفعة، تُقيَّم القواعد على **الحالة بعد الكتابة**، فشرط
        // «مقعد حر» قبل الكتابة كان سيرفض حجز **المقعد الأخير** نفسه (لحظة
        // الاكتمال). لذلك نفحص ألّا تتجاوز العضوية السعة بعد التنفيذ؛ أما
        // ضمان «مقعد واحد مقابل كل حجز» فهو حصرًا في قاعدتي studyGroups
        // (ب) و(ج) — زيادة/نقصان **واحد بالضبط** بلا تغيير أي حقل آخر.
        function parentWithinCapacity() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken <= get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
        }

        allow create: if isAdmin() || (
          signedIn()
          && request.auth.uid == parentTeacherId()
          && memberId == request.resource.data.studentId
          && request.resource.data.keys().hasOnly(
               ['studentId', 'groupId', 'name', 'joinedAt', 'status'])
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && parentWithinCapacity()
        );

        // التعديل إداري فقط (لا حالة عضو تُكتب من التطبيق).
        allow update: if isAdmin();

        // الإزالة (P9): صاحب المجموعة أو الإدارة. الحذف وحده لا يكفي — التطبيق
        // ينقص seatsTaken في المعاملة نفسها، وقاعدة studyGroups (ج) تسمح بمقعد
        // واحد فقط، فلا يمكن «حذف عضو» دون تحرير مقعده ولا العكس.
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == parentTeacherId());
      }

      // ── P9: الجدول الأسبوعي ──────────────────────────────────────────────
      // القراءة: صاحب المجموعة وكل عضو مقبول. الكتابة: صاحب المجموعة فقط.
      match /sessions/{sessionId} {
        function groupOwnerId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        function isOwner() {
          return signedIn() && request.auth.uid == groupOwnerId();
        }

        function isMember() {
          return signedIn() && exists(/databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid));
        }

        function sessionKeys() {
          return ['groupId', 'teacherId', 'title', 'weekday', 'startMinutes',
                  'durationMinutes', 'locationNote', 'isCancelled', 'createdAt'];
        }

        // نفس حدود العميل (SessionRules)، والحصة لا تعبر منتصف الليل.
        function validSession() {
          return request.resource.data.title is string
            && request.resource.data.title.size() >= 3
            && request.resource.data.title.size() <= 60
            && request.resource.data.weekday in ['saturday', 'sunday', 'monday',
                 'tuesday', 'wednesday', 'thursday', 'friday']
            && request.resource.data.startMinutes is int
            && request.resource.data.startMinutes >= 0
            && request.resource.data.startMinutes <= 1380
            && request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 15
            && request.resource.data.durationMinutes <= 240
            && request.resource.data.startMinutes + request.resource.data.durationMinutes <= 1440
            && request.resource.data.isCancelled is bool
            && request.resource.data.locationNote is string
            && request.resource.data.locationNote.size() <= 60;
        }

        allow read: if isAdmin() || isOwner() || isMember();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(sessionKeys())
          && request.resource.data.groupId == groupId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.isCancelled == false
          && validSession();

        // التعديل لا ينقل الموعد لمجموعة أخرى ولا يغيّر مالكه.
        allow update: if isOwner()
          && request.resource.data.keys().hasOnly(sessionKeys())
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.teacherId == resource.data.teacherId
          && validSession();

        // لا حذف من التطبيق: الإلغاء عبر isCancelled يحفظ سجل الجدول.
        allow delete: if isAdmin();
      }

      // ── P9: محادثة المجموعة ──────────────────────────────────────────────
      // نفس الجمهور: المالك والأعضاء المقبولون فقط. ولا تعديل ولا حذف بعد
      // الإرسال — سجل المحادثة للقراءة فقط بعد كتابته.
      match /messages/{messageId} {
        function groupOwnerId() {
          return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
        }

        function isOwner() {
          return signedIn() && request.auth.uid == groupOwnerId();
        }

        function isMember() {
          return signedIn() && exists(/databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid));
        }

        allow read: if isAdmin() || isOwner() || isMember();

        // لا انتحال مرسل: senderId يجب أن يساوي uid الطالب، ولا يكتب إلا عضو
        // أو المالك. الطول والمفاتيح مقيدة، والوقت من العميل (خادم الزمن
        // الكامل يحتاج دالة — مقبول لأن الترتيب فقط هو المستخدم).
        allow create: if (isOwner() || isMember())
          && request.resource.data.keys().hasOnly(
               ['groupId', 'senderId', 'senderName', 'senderRole', 'text', 'sentAt'])
          && request.resource.data.groupId == groupId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.senderRole in ['student', 'teacher']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.sentAt is timestamp;

        allow update, delete: if isAdmin();
      }
    }

    // ── 4) groupJoinRequests/{requestId} — طلبات الانضمام (P8) ───────────────
    // المعرّف حتمي: `groupId_studentId`، فطلب واحد لكل طالب في كل مجموعة.
    // المالك منسوخ في المستند (teacherId) حتى تكون القراءة فحصًا على حقول
    // المستند نفسه بلا get() لكل سطر في القائمة.
    match /groupJoinRequests/{requestId} {
      function joinRequestKeys() {
        return ['groupId', 'groupTitle', 'teacherId', 'studentId',
                'studentName', 'status', 'requestedAt', 'decidedAt',
                'decidedBy'];
      }

      // سطر واحد لكل تعبير: أسهل في المراجعة، ولا يعتمد على متابعة السطر.
      function groupIsActive(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.isActive == true;
      }

      function groupHasFreeSeat(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken < get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
      }

      function groupIsJoinable(groupId) {
        return groupIsActive(groupId) && groupHasFreeSeat(groupId);
      }

      function validNewRequest() {
        return request.resource.data.groupId is string
          && request.resource.data.groupTitle is string
          && request.resource.data.groupTitle.size() >= 3
          && request.resource.data.groupTitle.size() <= 80
          && request.resource.data.teacherId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 80
          && request.resource.data.requestedAt is timestamp
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(joinRequestKeys());
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.studentId == request.auth.uid
             || resource.data.teacherId == request.auth.uid
           ));

      // الطالب ينشئ طلبه فقط، لطالب مسجّل، لمجموعة منشورة بها مقعد، وبمعرّف
      // المستند المشتق. لا يستطيع كتابة حالة غير pending ولا نسب الطلب لمدرس آخر.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && requestId == request.resource.data.groupId + '_' + request.auth.uid
        && validNewRequest()
        && groupIsJoinable(request.resource.data.groupId)
        && request.resource.data.teacherId == get(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)).data.teacherId
        && request.resource.data.teacherId != request.auth.uid;

      // (أ) قرار المدرس: pending ← accepted/rejected، وبلا لمس أي حقل آخر.
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);

      // (ب) إلغاء الطالب لطلبه المعلّق — الحالة فقط.
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // (ج) إعادة الطلب بعد رفض/إلغاء: نفس المستند يعود pending، بشرط أن
      // تكون المجموعة ما زالت منشورة وبها مقعد (السعة تُفحص من جديد).
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status in ['rejected', 'cancelled']
        && validNewRequest()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == resource.data.teacherId
        && groupIsJoinable(resource.data.groupId);

      // لا حذف من التطبيق: سجل الطلب يبقى للسجل التاريخي.
      allow delete: if isAdmin();
    }

    // ── 4-ب) groupWaitlist/{entryId} — قائمة انتظار المجموعة المكتملة (P9) ──
    // المعرّف حتمي: `groupId_studentId`، فصف واحد لكل طالب في كل مجموعة.
    // **المنتظر ليس عضوًا**: لا مستند في members، فلا يقرأ الجدول ولا المحادثة.
    match /groupWaitlist/{entryId} {
      function waitlistKeys() {
        return ['groupId', 'groupTitle', 'teacherId', 'studentId',
                'studentName', 'status', 'addedAt', 'decidedAt', 'decidedBy'];
      }

      function groupIsActive(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.isActive == true;
      }

      function groupIsFull(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTaken >= get(/databases/$(database)/documents/studyGroups/$(groupId)).data.seatsTotal;
      }

      function groupOwnerId(groupId) {
        return get(/databases/$(database)/documents/studyGroups/$(groupId)).data.teacherId;
      }

      function validNewEntry() {
        return request.resource.data.groupId is string
          && request.resource.data.groupTitle is string
          && request.resource.data.groupTitle.size() >= 3
          && request.resource.data.groupTitle.size() <= 80
          && request.resource.data.teacherId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 80
          && request.resource.data.addedAt is timestamp
          && request.resource.data.status == 'waiting'
          && request.resource.data.keys().hasOnly(waitlistKeys());
      }

      allow read: if isAdmin()
        || (signedIn() && (
             resource.data.studentId == request.auth.uid
             || resource.data.teacherId == request.auth.uid
           ));

      // الطالب يضيف نفسه فقط، لمجموعة **مكتملة** ومنشورة، وبمعرّف مشتق.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && entryId == request.resource.data.groupId + '_' + request.auth.uid
        && validNewEntry()
        && groupIsActive(request.resource.data.groupId)
        && groupIsFull(request.resource.data.groupId)
        && request.resource.data.teacherId == groupOwnerId(request.resource.data.groupId)
        && request.resource.data.teacherId != request.auth.uid;

      // (أ) المدرس يقبل منتظرًا: waiting ← promoted، وبلا لمس أي حقل آخر.
      // زيادة المقعد تحدث بتعديل منفصل على المجموعة تقبله القاعدة (ب).
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'promoted'
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);

      // (ب) الطالب يغادر الطابور — الحالة فقط، وبلا قرار مدرس.
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'left'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // (ج) العودة بعد المغادرة: الصف نفسه يعود waiting، بشرط أن تكون المجموعة
      // ما زالت مكتملة ومنشورة (تُفحص من جديد، لا اعتمادًا على الحالة القديمة).
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'left'
        && validNewEntry()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == resource.data.teacherId
        && resource.data.teacherId == groupOwnerId(resource.data.groupId)
        && groupIsActive(resource.data.groupId)
        && groupIsFull(resource.data.groupId);

      // لا حذف من التطبيق: سجل الانتظار يبقى.
      allow delete: if isAdmin();
    }

    // ── 5) bookingRequests/{bookingId} ───────────────────────────────────────
    // القراءة لطرفي الطلب فقط. الكتابة (إنشاء/قبول/رفض) لم تُفتح بعد.
    match /bookingRequests/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && (
             request.auth.uid == resource.data.studentId
             || request.auth.uid == resource.data.teacherId
           ));

      allow write: if isAdmin();
    }

    // ── 6) كل ما لم يُذكر: ممنوع ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
